{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "K2 data product descriptor, domain registry and contract profile",
  "description": "Read by k2gen validate. Each definition is applied on its own: domains to contracts/domains.yaml, product to each product.yaml, contract to each *.odcs.yaml after the ODCS schema, customProperties to that contract's customProperties folded into one object.",
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "table": {
      "description": "An Iceberg identifier without the lake. catalog: <namespace>.<table>.",
      "type": "string",
      "pattern": "^[a-z]+\\.[a-z0-9_]+$"
    },
    "classification": {
      "description": "Ordered public < internal < restricted. A table is at least as restricted as each of its upstreams.",
      "enum": ["public", "internal", "restricted"]
    },
    "domains": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domains"],
      "properties": {
        "domains": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/slug"},
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["owner", "kind", "description"],
            "properties": {
              "owner": {"$ref": "#/$defs/slug"},
              "kind": {"enum": ["source-aligned", "consumer-aligned"]},
              "description": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "domain", "owner", "purpose", "kind", "lifecycle", "inputs", "outputs", "consumers"],
      "anyOf": [
        {"description": "A product writes at least one lake table,", "properties": {"outputs": {"minItems": 1}}},
        {"description": "or builds at least one mart and no lake table (ADR-035's delayed product).", "required": ["marts"], "properties": {"marts": {"minItems": 1}}}
      ],
      "properties": {
        "name": {"$ref": "#/$defs/slug"},
        "domain": {"$ref": "#/$defs/slug"},
        "owner": {"$ref": "#/$defs/slug"},
        "purpose": {"type": "string", "minLength": 1},
        "kind": {"enum": ["source-aligned", "consumer-aligned"]},
        "lifecycle": {"enum": ["draft", "published", "deprecated"]},
        "inputs": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["table"],
                "properties": {"table": {"$ref": "#/$defs/table"}}
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["external", "classification", "description"],
                "properties": {
                  "external": {"type": "string", "minLength": 1},
                  "classification": {"$ref": "#/$defs/classification"},
                  "description": {"type": "string", "minLength": 1}
                }
              }
            ]
          }
        },
        "outputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/table"}
        },
        "consumers": {
          "description": "Known readers outside the contracts: scripts, notebooks, the ClickHouse reload. Products that read this one name it in their inputs instead.",
          "type": "array",
          "items": {"type": "string"}
        },
        "marts": {
          "description": "Tables dbt builds on Trino for this product, in its domain's catalog (ADR-044). k2gen generates the dbt sources and selector from them (dbt/), and scripts/dbt_manifest_check.py holds the dbt project to them.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["table", "grain", "reads"],
            "properties": {
              "table": {
                "description": "<catalog>.<schema>.<table>: the domain id and the product name, each with underscores, then the model's name in dbt/models/<catalog>/marts/<schema>/.",
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
              },
              "grain": {
                "description": "The columns one row is unique on. The mart's dbt model must test exactly these for uniqueness.",
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
              },
              "reads": {
                "description": "The lake tables the mart's models select from, each an input or an output of this product.",
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"$ref": "#/$defs/table"}
              },
              "materialized": {
                "description": "How dbt builds it; a table when absent. A view only where the product is one by decision, as ADR-035's delayed product.",
                "enum": ["table", "view"]
              }
            }
          }
        }
      }
    },
    "contract": {
      "description": "K2's profile of an ODCS contract: the standard's optional fields K2 requires.",
      "type": "object",
      "required": ["name", "domain", "description", "team", "schema", "customProperties"],
      "properties": {
        "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "description": {"type": "object", "required": ["purpose"]},
        "team": {"type": "object", "required": ["name"]},
        "slaProperties": {
          "description": "Only where a check enforces a stated target. latency: how old the newest value of element, <table>.<column>, may be; k2gen makes it the dbt source freshness of a table a mart reads.",
          "type": "array",
          "items": {
            "if": {"properties": {"property": {"const": "latency"}}},
            "then": {
              "required": ["element", "unit"],
              "properties": {"value": {"type": "integer", "minimum": 1}, "unit": {"enum": ["min", "h", "d"]}}
            }
          }
        },
        "schema": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "physicalName", "physicalType"],
            "oneOf": [
              {
                "description": "A table lake.sql creates: referenced, columns not restated.",
                "required": ["authoritativeDefinitions"],
                "not": {"required": ["properties"]}
              },
              {
                "description": "A new table: inline columns, its DDL generated into docker/lake/ddl/generated/.",
                "required": ["properties"],
                "not": {"required": ["authoritativeDefinitions"]}
              }
            ],
            "properties": {
              "physicalName": {"$ref": "#/$defs/table"},
              "physicalType": {"const": "table"},
              "authoritativeDefinitions": {
                "contains": {
                  "type": "object",
                  "required": ["type", "url"],
                  "properties": {
                    "type": {"const": "implementation"},
                    "url": {"const": "docker/lake/ddl/lake.sql"}
                  }
                }
              },
              "properties": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["name", "physicalType", "description"],
                  "properties": {
                    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                    "physicalType": {
                      "description": "The Spark SQL type as the DDL spells it: STRING, TIMESTAMP, DECIMAL(28,10).",
                      "type": "string",
                      "pattern": "^[A-Z]"
                    },
                    "description": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          }
        }
      }
    },
    "customProperties": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "format", "partitioning", "sort", "classification", "entitlement", "retention", "upstreams", "schedule"],
      "properties": {
        "layer": {"description": "The lake namespace the table is in: one of the four layers, or audit, the checks the lake jobs file about every layer.", "enum": ["raw", "bronze", "silver", "gold", "audit"]},
        "format": {"const": "iceberg"},
        "partitioning": {
          "description": "Iceberg partition fields in order, as lake.sql spells them: days(recv_ts), exchange.",
          "type": "array",
          "items": {"type": "string"}
        },
        "sort": {
          "description": "The declared write sort order in lake.sql, in order. Empty when the table declares none.",
          "type": "array",
          "items": {"type": "string"}
        },
        "classification": {"$ref": "#/$defs/classification"},
        "entitlement": {"enum": ["realtime", "delayed", "none"]},
        "retention": {
          "description": "Snapshot expiry, in days. Not deletion of data: no row is ever deleted (ADR-028 section 12 stays in force, ADR-032).",
          "type": "integer",
          "minimum": 1
        },
        "upstreams": {
          "description": "What this table is computed from: tables of this product, or entries of the product's inputs.",
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "schedule": {
          "description": "Cron of the job that writes the table.",
          "type": "string"
        },
        "paused": {
          "description": "The table receives no new data by decision; its rows stay readable. since is the day it stopped, adr the decision. Removed on resume (ADR-050).",
          "type": "object",
          "additionalProperties": false,
          "required": ["since", "adr"],
          "properties": {
            "since": {"description": "A quoted YYYY-MM-DD: unquoted, YAML reads a date, not a string.", "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "adr": {"type": "string", "pattern": "^ADR-[0-9]{3}$"}
          }
        }
      }
    }
  }
}
