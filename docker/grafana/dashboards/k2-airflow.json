{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 1,
      "type": "timeseries",
      "title": "DAG run duration",
      "description": "Mean seconds from a run's start to its end, over 30 minutes, by DAG and outcome. No DAG runs until phase 002 adds the first product DAG; the old lake DAGs are retired (legacy/v3-lake-ingest/).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "increase(airflow_dagrun_duration_success_sum[30m]) / increase(airflow_dagrun_duration_success_count[30m])",
          "legendFormat": "{{dag_id}} success",
          "refId": "A"
        },
        {
          "expr": "increase(airflow_dagrun_duration_failed_sum[30m]) / increase(airflow_dagrun_duration_failed_count[30m])",
          "legendFormat": "{{dag_id}} failed",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 2,
      "type": "timeseries",
      "title": "Run lateness",
      "description": "Mean seconds between a run's scheduled time and the moment it started, over 30 minutes (dagrun.schedule_delay). Airflow 3 has no SLA-miss feature; this is the panel that replaces it. A run waits here while the one before it still holds the only slot (max_active_runs=1).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "increase(airflow_dagrun_schedule_delay_sum[30m]) / increase(airflow_dagrun_schedule_delay_count[30m])",
          "legendFormat": "{{dag_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 3,
      "type": "timeseries",
      "title": "Task failures",
      "description": "Task tries that ended failed (retries spent) or up_for_retry (a retry follows), per hour. AirflowTaskFailed fires on the first.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (dag_id, task_id) (increase(airflow_ti_finish{state=\"failed\"}[1h]))",
          "legendFormat": "{{dag_id}}.{{task_id}} failed",
          "refId": "A"
        },
        {
          "expr": "sum by (dag_id, task_id) (increase(airflow_ti_finish{state=\"up_for_retry\"}[1h]))",
          "legendFormat": "{{dag_id}}.{{task_id}} retried",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 4,
      "type": "timeseries",
      "title": "Skips",
      "description": "Task tries that ended skipped, per hour: a task whose run decided there was nothing to do, or one skipped because a task before it failed. The task log says which.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (dag_id, task_id) (increase(airflow_ti_finish{state=\"skipped\"}[1h]))",
          "legendFormat": "{{dag_id}}.{{task_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 5,
      "type": "timeseries",
      "title": "Scheduler heartbeat",
      "description": "Scheduler heartbeats per second, about 0.2 when healthy (one every 5 s). Zero, or no line at all, for five minutes is AirflowSchedulerHeartbeatLost; the airflow-statsd up line says whether it is the scheduler or the exporter.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "rate(airflow_scheduler_heartbeat[2m])",
          "legendFormat": "heartbeats/s",
          "refId": "A"
        },
        {
          "expr": "up{job=\"airflow-statsd\"}",
          "legendFormat": "airflow-statsd up",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 6,
      "type": "timeseries",
      "title": "DAG parse time",
      "description": "Seconds the dag-processor spent importing each DAG file (mean over 10 minutes), and the whole parse loop. A rise here is a DAG file doing work at import, which a DAG file should not.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "increase(airflow_dag_processing_last_duration_sum[10m]) / increase(airflow_dag_processing_last_duration_count[10m])",
          "legendFormat": "{{file_name}}",
          "refId": "A"
        },
        {
          "expr": "airflow_dag_processing_total_parse_time",
          "legendFormat": "total parse loop",
          "refId": "B"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
