  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Is the lake current?",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 2,
      "type": "stat",
      "title": "Ingest lag",
      "description": "Age of the newest Kafka record in raw.messages, read from the latest ingest snapshot summary. LakeIngestLagHigh fires at 900s. This is not the same as commit age: the ingest can be committing on schedule and still be behind on a backlog.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 900
              },
              {
                "color": "red",
                "value": 1800
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "time() - k2_lake_max_kafka_ts_seconds",
          "refId": "A",
          "legendFormat": "lag"
        }
      ]
    },
    {
