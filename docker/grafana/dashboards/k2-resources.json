        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(container_cpu_usage_seconds_total{job=\"cadvisor\"}[$__rate_interval]))",
          "legendFormat": "CPU in use (cores)",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 3,
      "type": "gauge",
      "title": "CPU limits against the 25-core ceiling",
      "description": "Sum of every running container's CPU limit. The ceiling is ADR-045's 25 CPU / 48 GiB, which scripts/check-budget.py gates at the bootstrap peak: every default service's limit, the five one-shots included. A one-shot that has exited has no cgroup, so this sum is the long-running services only, and sits below the gated figure by the one-shots' 2 CPU / 2.5 GiB.",
      "gridPos": {
        "h": 6,
        "w": 7,
        "x": 5,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "none",
          "mappings": [],
          "min": 0,
          "max": 25,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 23.75
              },
              {
                "color": "red",
                "value": 25
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(container_spec_cpu_quota{job=\"cadvisor\"} / container_spec_cpu_period{job=\"cadvisor\"})",
          "legendFormat": "CPU limits against the 25-core ceiling",
          "refId": "A"
        }
      ]
    },
