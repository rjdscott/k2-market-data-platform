{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::@LAKE@/warehouse/@K2@/*", "arn:aws:s3:::@LAKE@/warehouse/@DOMAIN@/*"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::@LAKE@"],
      "Condition": {"StringLike": {"s3:prefix": ["warehouse/@K2@/*", "warehouse/@DOMAIN@/*"]}}
    }
  ]
}
