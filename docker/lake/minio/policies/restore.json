{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": ["arn:aws:s3:::@LAKE@/warehouse/@K2@/*", "arn:aws:s3:::@LAKE@/warehouse/@DOMAIN@/*", "arn:aws:s3:::@LANDING@/*"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::@LAKE@"],
      "Condition": {"StringLike": {"s3:prefix": ["warehouse/@K2@/*", "warehouse/@DOMAIN@/*"]}}
    },
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::@LANDING@"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation"],
      "Resource": ["arn:aws:s3:::@LAKE@", "arn:aws:s3:::@LANDING@"]
    }
  ]
}
