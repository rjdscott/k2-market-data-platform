{
  "landing": {
    "bucket": "k2-landing",
    "prefixes": [
      "fx-reference/ecb-fx-rates/",
      "market-capture/kraken-instruments/",
      "reference-data/currency-master/"
    ]
  },
  "warehouses": [
    {
      "name": "fx_reference",
      "namespaces": [
        "ecb_fx_rates",
        "ecb_fx_rates__base"
      ],
      "remoteSigningEnabled": false
    },
    {
      "name": "governance",
      "namespaces": [
        "access_canary",
        "access_canary__base",
        "quality_results",
        "quality_results__base",
        "run_records"
      ],
      "remoteSigningEnabled": false
    },
    {
      "name": "k2",
      "namespaces": [
        "currency_master",
        "ecb_fx_rates",
        "kraken_instruments",
        "kraken_trades"
      ],
      "remoteSigningEnabled": false
    },
    {
      "name": "market_analytics",
      "namespaces": [
        "candles",
        "candles__base",
        "canonical_trades",
        "canonical_trades__base"
      ],
      "remoteSigningEnabled": false
    },
    {
      "name": "market_capture",
      "namespaces": [
        "kraken_instruments",
        "kraken_instruments__base",
        "kraken_trades",
        "kraken_trades__base"
      ],
      "remoteSigningEnabled": false
    },
    {
      "name": "reference_data",
      "namespaces": [
        "calendars",
        "calendars__base",
        "currency_master",
        "currency_master__base",
        "security_master",
        "security_master__base"
      ],
      "remoteSigningEnabled": false
    }
  ]
}
