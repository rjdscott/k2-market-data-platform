{
  "bronze": [
    {
      "audits": [],
      "branch": "audit",
      "checks": "lake.kraken_instruments.audit_checks",
      "decimal": [],
      "key": [
        "pair_code",
        "ws_name",
        "base",
        "quote",
        "tick_size",
        "pair_decimals",
        "lot_decimals",
        "order_min",
        "status",
        "fetched_at",
        "source_file_sha256"
      ],
      "patterns": {},
      "table": "lake.kraken_instruments.bronze_pairs",
      "values": []
    }
  ],
  "build": {
    "engine": "dbt",
    "outputs": [
      "market_capture_build.kraken_instruments__base.silver_listing"
    ],
    "publisher": "pub_kraken_instruments",
    "selector": "kraken_instruments",
    "writer": "dbt_kraken_instruments"
