# The nightly host copy of the catalog and Airflow databases, and of the lake
# tables in its list, empty until phase 002 (scripts/backup-lake.sh). A user
# unit: `make backup-install` writes it to ~/.config/systemd/user with
# @K2_ROOT@ set to the checkout it ran from.
[Unit]
Description=K2 nightly backup of the catalog and Airflow databases
Documentation=file://@K2_ROOT@/docs/runbooks/lake-backup-and-restore.md

[Service]
Type=oneshot
ExecStart=/usr/bin/env bash "@K2_ROOT@/scripts/backup-lake.sh"
