# Daily at 04:30 UTC: the hour was set to follow the old nightly lake
# maintenance, retired with the old lake ingest (legacy/v3-lake-ingest/), and is
# kept. Persistent: a run missed while the host was off or logged out happens at
# the next login.
[Unit]
Description=K2 nightly backup, daily at 04:30 UTC

[Timer]
OnCalendar=*-*-* 04:30:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
