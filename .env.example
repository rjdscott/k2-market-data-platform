# K2 Market Data Platform — Environment Variables
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values — never commit .env to git
#
# .env is loaded automatically by docker-compose from the project root.
# Python offload scripts read these via os.environ at runtime.

# ─────────────────────────────────────────────────────────────────────────────
# ClickHouse
# ─────────────────────────────────────────────────────────────────────────────
# Password for the ClickHouse 'default' user (set at container init time).
# Changing this after the container is first created requires recreating the
# container and its volume.
CLICKHOUSE_PASSWORD=change-me-in-production

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL (Prefect metadata + offload watermarks)
# ─────────────────────────────────────────────────────────────────────────────
PREFECT_DB_USER=prefect
PREFECT_DB_PASSWORD=change-me-in-production
PREFECT_DB_NAME=prefect

# ─────────────────────────────────────────────────────────────────────────────
# MinIO (S3-compatible object storage for Iceberg cold tier)
# ─────────────────────────────────────────────────────────────────────────────
# These are also used by the Spark container as AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY so they must match between the two services.
MINIO_ROOT_USER=change-me-in-production
MINIO_ROOT_PASSWORD=change-me-in-production

# ─────────────────────────────────────────────────────────────────────────────
# Lakekeeper (Iceberg REST catalog — v3, ADR-018)
# ─────────────────────────────────────────────────────────────────────────────
# Encrypts warehouse storage credentials at rest in the `lakekeeper` PostgreSQL
# database (LAKEKEEPER__PG_ENCRYPTION_KEY). Lakekeeper documents no minimum
# length, only that the default must not be used in production. Generate one:
#
#   openssl rand -base64 32
#
# Changing it after warehouses exist makes their stored credentials
# undecryptable — rotate by recreating the warehouse, not by editing this line.
LAKEKEEPER_ENCRYPTION_KEY=change-me-in-production

# ─────────────────────────────────────────────────────────────────────────────
# Grafana
# ─────────────────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=change-me-in-production

# ─────────────────────────────────────────────────────────────────────────────
# Rust capture tier (v3 Phase C — capture-binance/kraken/coinbase)
# ─────────────────────────────────────────────────────────────────────────────
# CPU cores the three capture-* containers are pinned to. The default is
# `12-14` (compose: `${K2_CAPTURE_CPUSET-12-14}`), which is the layout
# docs/plans/2026-08-26-v3-quant-research-platform/005-phase-f-notebooks-numbers-docs.md
# specifies: three cores away from the low cores ClickHouse and Spark contend
# for. It needs a host with at least 15 cores.
#
# On a smaller host set this to a range that exists (e.g. `2-3`), or set it to
# the EMPTY string to run unpinned — the compose default uses `-` and not `:-`
# precisely so that an explicit empty value wins over the default:
#
#     K2_CAPTURE_CPUSET=
#
# A cpuset naming a core the host does not have fails the container at start
# with `invalid argument`, so this value is host-specific and lives here.
K2_CAPTURE_CPUSET=12-14
