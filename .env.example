# K2 Market Data Platform — Environment Variables
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values — never commit .env to git
#
# .env is loaded automatically by docker-compose from the project root.
# The Python jobs in docker/lake/ read these via os.environ at runtime.

# ─────────────────────────────────────────────────────────────────────────────
# ClickHouse
# ─────────────────────────────────────────────────────────────────────────────
# Password for the ClickHouse 'default' user (set at container init time).
# Changing this after the container is first created requires recreating the
# container and its volume.
CLICKHOUSE_PASSWORD=change-me-in-production
# Read-only research user on the gold database (docker/clickhouse/users.xml)
K2_QUANT_PASSWORD=change-me-in-production

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL (Prefect metadata + the Lakekeeper catalog database)
# ─────────────────────────────────────────────────────────────────────────────
PREFECT_DB_USER=prefect
PREFECT_DB_PASSWORD=change-me-in-production
PREFECT_DB_NAME=prefect

# ─────────────────────────────────────────────────────────────────────────────
# MinIO (S3-compatible object storage backing the Iceberg lake)
# ─────────────────────────────────────────────────────────────────────────────
# These are also used by the Spark container as AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY so they must match between the two services.
MINIO_ROOT_USER=change-me-in-production
MINIO_ROOT_PASSWORD=change-me-in-production

# ─────────────────────────────────────────────────────────────────────────────
# Lakekeeper (Iceberg REST catalog — v3, ADR-018)
# ─────────────────────────────────────────────────────────────────────────────
# Encrypts warehouse storage credentials at rest in the `lakekeeper` PostgreSQL
# database (LAKEKEEPER__PG_ENCRYPTION_KEY). Lakekeeper documents no minimum
# length, only that the default must not be used in production. Generate one:
#
#   openssl rand -base64 32
#
# Changing it after warehouses exist makes their stored credentials
# undecryptable — rotate by recreating the warehouse, not by editing this line.
LAKEKEEPER_ENCRYPTION_KEY=change-me-in-production

# ─────────────────────────────────────────────────────────────────────────────
# Grafana
# ─────────────────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=change-me-in-production

# ─────────────────────────────────────────────────────────────────────────────
# Rust capture tier (v3 Phase C — capture-binance/kraken/coinbase)
# ─────────────────────────────────────────────────────────────────────────────
# CPU cores the capture-* containers (and, disjointly, the heavy tier:
# ClickHouse, Spark, lake-ddl) are pinned to. Shipped EMPTY = no pinning, which
# is the only value that starts on every host: a cpuset naming a core the host
# does not have fails the container with `invalid argument`. Empty wins over the
# compose default because compose uses `${K2_CAPTURE_CPUSET-12-14}` (`-`, not
# `:-`), which only falls back when the variable is unset, not when it is empty.
#
# The 15-core layout below is what
# docs/plans/2026-08-26-v3-quant-research-platform/005-phase-f-notebooks-numbers-docs.md
# specifies — capture three cores away from the low cores ClickHouse and Spark
# contend for. Uncomment it on a host with at least 15 cores, or set your own
# ranges (e.g. `2-3` / `0-1`). Host-specific, which is why it lives here.
#
#     K2_CAPTURE_CPUSET=12-14
#     K2_HEAVY_CPUSET=0-11
K2_CAPTURE_CPUSET=
K2_HEAVY_CPUSET=

# ─────────────────────────────────────────────────────────────────────────────
# Host ports
# ─────────────────────────────────────────────────────────────────────────────
# Prefect's published port. It is one variable because the compose file uses it
# twice — the `ports` mapping and PREFECT_UI_API_URL, the URL the UI calls from
# the browser — and the two must agree or the UI loads and then fails every
# request. Change it here if something else on the host owns 4200.
K2_PREFECT_PORT=4200
